# Any OpenAI-compatible endpoint works (Groq, OpenAI, OpenRouter, Ollama, ...)
# Gemini: BOB_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#         BOB_LLM_MODEL=gemini-2.5-flash
# Put your real key in .env (git-ignored), never in this file.
BOB_LLM_BASE_URL=https://api.groq.com/openai/v1
BOB_LLM_API_KEY=
BOB_LLM_MODEL=llama-3.3-70b-versatile
# Where your resume.tex, profile.yaml and runs live
BOB_HOME=./workspace
